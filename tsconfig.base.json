{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    }
}